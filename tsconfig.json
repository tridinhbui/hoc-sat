{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "vitest.config.ts",
    "tests/**/*.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "cloudflare-env.d.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".open-next",
    // `next dev` sinh ra .next/dev/types với tập route THIẾU — nó chỉ biết
    // những route đã compile lazily. Để lẫn vào đây thì typecheck ra kết quả
    // khác nhau tuỳ lúc đó dev server đã mở trang nào.
    // Nguồn sự thật là .next/types, do `next typegen` sinh (xem script typecheck).
    ".next/dev"
  ]
}
